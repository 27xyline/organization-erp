# Local PostgreSQL for host-run Python commands. Compose services use the
# postgres service name and derive the same database from POSTGRES_* below.
POSTGRES_USER="project1"
POSTGRES_PASSWORD="change-this-local-password"
POSTGRES_DB="project1"
POSTGRES_PORT=5434
BACKEND_DATABASE_URL="postgresql+asyncpg://project1:change-this-local-password@localhost:5434/project1"

# Generate a private CSRF signing secret with: openssl rand -hex 32
BACKEND_CSRF_SECRET="replace-with-a-unique-csrf-secret-32-plus-bytes"
BACKEND_PUBLIC_ORIGIN="http://localhost:3001"

# Host-run Next.js reads frontend/.env.local; Compose uses backend:8000.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
BACKEND_ENVIRONMENT=development
BACKEND_PORT=8000

# App and document storage
PORT=3001
APP_PORT=3001
DOCUMENT_STORAGE_ROOT="./.runtime/documents"
DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
