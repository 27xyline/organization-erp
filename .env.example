# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
PORT=3001
APP_PORT=3001

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
