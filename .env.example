# Database
POSTGRES_USER="project1"
POSTGRES_PASSWORD="change-this-local-password"
POSTGRES_DB="project1"
POSTGRES_PORT=5434
DATABASE_URL="postgresql://project1:change-this-local-password@localhost:5434/project1"

# Python backend uses the isolated stage00 copy; never point it at project1.
# For direct host execution, replace `postgres` with `localhost`.
BACKEND_DATABASE_URL="postgresql+asyncpg://project1:change-this-local-password@postgres:5432/erp_migration_20261007"
BACKEND_ENVIRONMENT=development
BACKEND_OTEL_ENABLED=false
BACKEND_OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
BACKEND_PORT=8000

# Yandex.Disk OAuth
YANDEX_CLIENT_ID="your_yandex_client_id"
YANDEX_CLIENT_SECRET="your_yandex_client_secret"
YANDEX_REDIRECT_URI="http://localhost:3001/api/auth/yandex/callback"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
PORT=3001
APP_PORT=3001

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"

# Local document storage (never place this under public/ or .next/)
DOCUMENT_STORAGE_ROOT="./.runtime/documents"
DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
