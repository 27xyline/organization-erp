# Локальная PostgreSQL для команд Python, запускаемых на хосте. Сервисы Compose
# обращаются к сервису postgres и используют ту же БД из переменных POSTGRES_* ниже.
POSTGRES_USER="project1"
POSTGRES_PASSWORD="change-this-local-password"
POSTGRES_DB="project1"
POSTGRES_PORT=5434
BACKEND_DATABASE_URL="postgresql+asyncpg://project1:change-this-local-password@localhost:5434/project1"

# Сгенерируйте секретный ключ подписи CSRF командой: openssl rand -hex 32
BACKEND_CSRF_SECRET="replace-with-a-unique-csrf-secret-32-plus-bytes"
BACKEND_PUBLIC_ORIGIN="http://localhost:3001"

# Next.js на хосте читает frontend/.env.local; в Compose используется backend:8000.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
BACKEND_ENVIRONMENT=development
BACKEND_PORT=8000

# Приложение и хранилище документов
PORT=3001
APP_PORT=3001
DOCUMENT_STORAGE_ROOT="./var/documents"
DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
