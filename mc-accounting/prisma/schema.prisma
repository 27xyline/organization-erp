generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mol {
  id          String   @id @default(cuid())
  code        String   @unique
  department  String
  fullName    String
  storageLocation String
  photo       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  assets      Asset[]
  operationsFrom Operation[] @relation("FromMol")
  operationsTo   Operation[] @relation("ToMol")
  
  @@map("mols")
}

model AssetGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  assets      Asset[]
  
  @@map("asset_groups")
}

model Asset {
  id              String   @id @default(cuid())
  orderNumber     Int      @default(autoincrement())
  name            String
  inventoryNumber String   @unique
  unitPrice       Decimal  @db.Decimal(10, 2)
  unitOfMeasure   String
  quantity        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  
  molId           String
  mol             Mol      @relation(fields: [molId], references: [id])
  
  groupId         String
  group           AssetGroup @relation(fields: [groupId], references: [id])
  
  // Project relation
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  
  // Source of purchase
  contractCode    String?
  internalFundingCode String?
  isExistingAsset Boolean  @default(false)
  
  // Basis for recording
  recordingDate   DateTime
  documentType    String
  documentDetails String
  
  // Yandex.Disk file references
  documentFiles   String[] @default([])
  
  // Status
  status          AssetStatus @default(IN_STOCK)
  
  // Archive flag
  isArchived      Boolean  @default(false)
  
  // Planning
  plannedDisposalDate DateTime?
  plannedDisposalReason String?
  
  // Photos and notes
  photos          String[] @default([])
  notes           String?
  
  // Accounting form (145 or 367)
  accountingForm  String   @default("145")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  operations      Operation[]
  
  @@map("assets")
}

enum AssetStatus {
  IN_STOCK
  IN_USE
  UNDER_REPAIR
  PLANNED_FOR_DISPOSAL
  PARTIALLY_DISPOSED
  FULLY_DISPOSED
  
  @@map("asset_status")
}

enum OperationType {
  RECEIPT
  TRANSFER
  DISPOSAL
  STATUS_CHANGE
  
  @@map("operation_type")
}

model Operation {
  id          String   @id @default(cuid())
  type        OperationType
  
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  
  // For transfers
  fromMolId   String?
  fromMol     Mol?     @relation("FromMol", fields: [fromMolId], references: [id])
  
  toMolId     String?
  toMol       Mol?     @relation("ToMol", fields: [toMolId], references: [id])
  
  // Quantities
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(12, 2)
  
  // Document info
  date        DateTime
  reason      String?
  documentType String
  documentDetails String
  documentFiles String[] @default([])
  
  // Status change
  oldStatus   AssetStatus?
  newStatus   AssetStatus?
  
  createdAt   DateTime @default(now())
  
  @@map("operations")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())
  
  @@map("audit_logs")
}

// Projects
enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  
  @@map("project_status")
}

model Project {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  goals       String?
  tasks       String?
  results     String?
  
  // Dates
  startDate   DateTime?
  endDate     DateTime?
  
  // Status
  status      ProjectStatus @default(ACTIVE)
  
  // Budget
  plannedBudget Decimal  @db.Decimal(12, 2) @default(0)
  actualBudget  Decimal  @db.Decimal(12, 2) @default(0)
  
  // Relations
  assets      Asset[]
  tasksList   Task[]
  financePlanEntries FinancePlanEntry[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("projects")
}

// Tasks with 3-level hierarchy
model Task {
  id          String   @id @default(cuid())
  name        String
  
  // Hierarchy (Level 1, 2, 3)
  level       Int      @default(1) // 1, 2, or 3
  parentId    String?
  parent      Task?    @relation("TaskChildren", fields: [parentId], references: [id])
  children    Task[]   @relation("TaskChildren")
  
  // Dates and duration
  startDate   DateTime?
  endDate     DateTime?
  duration    Int?     // in days
  
  // Progress
  progress    Int      @default(0) // 0-100%
  
  // Responsible person
  responsible String?
  
  // Status
  status      TaskStatus @default(NOT_STARTED)
  
  // Project relation
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("tasks")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED

  @@map("task_status")
}

// Employees and HR
model Employee {
  id          String   @id @default(cuid())
  code        String   @unique // Табельный номер
  fullName    String
  department  String
  photo       String?
  contractType EmploymentContractType @default(PRIMARY)
  contractSignedDate DateTime?
  contractEndDate DateTime?
  contractNumber String?
  
  // Contact info
  phone       String?
  email       String?
  
  // Staff schedule position
  staffScheduleId String?
  staffSchedule   StaffSchedule? @relation(fields: [staffScheduleId], references: [id])
  
  // Status
  status      EmployeeStatus @default(ACTIVE)
  
  // Relations
  vacations   Vacation[]
  actions     PersonnelAction[]
  salaryEntries SalaryEntry[]
  financePlanEntries FinancePlanEntry[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  ON_VACATION
  ON_SICK_LEAVE
  DISMISSED
  
  @@map("employee_status")
}

enum EmploymentContractType {
  PRIMARY
  INTERNAL
  EXTERNAL

  @@map("employment_contract_type")
}

model StaffSchedule {
  id          String   @id @default(cuid())
  position    String   // Название должности
  department  String   // Отдел
  rate        Decimal  @db.Decimal(3, 2) // Количество ставок
  salary      Decimal  @db.Decimal(10, 2) // Зарплата
  
  // Relations
  employees   Employee[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("staff_schedule")
}

model SalaryEntry {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@map("salary_entries")
}

enum FinancePlanType {
  OKLAD
  NADBAVKA

  @@map("finance_plan_type")
}

model FinancePlanEntry {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  year        Int
  month       Int
  type        FinancePlanType
  amount      Decimal         @db.Decimal(12, 2)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, year, month, type, projectId])
  @@index([employeeId, year, month, type])
  @@index([year, month, type])
  @@map("finance_plan_entries")
}

model PersonnelAction {
  id          String   @id @default(cuid())
  type        PersonnelActionType
  date        DateTime
  description String?
  
  // Employee
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  
  // Additional data
  oldDepartment String?
  newDepartment String?
  oldPosition   String?
  newPosition   String?
  oldContractEndDate DateTime?
  newContractEndDate DateTime?
  
  createdAt   DateTime @default(now())
  
  @@map("personnel_actions")
}

enum PersonnelActionType {
  HIRE
  DISMISS
  ARCHIVE
  TRANSFER
  EXTEND
  PROMOTE
  EDIT
  
  @@map("personnel_action_type")
}

model Vacation {
  id          String   @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  type        VacationType @default(VACATION)
  
  // Employee
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  
  createdAt   DateTime @default(now())
  
  @@map("vacations")
}

enum VacationType {
  VACATION
  SICK_LEAVE
  BUSINESS_TRIP
  UNPAID_LEAVE
  
  @@map("vacation_type")
}
