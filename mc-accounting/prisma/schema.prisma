generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mol {
  id          String   @id @default(cuid())
  code        String   @unique
  department  String
  fullName    String
  storageLocation String
  photo       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  assets      Asset[]
  operationsFrom Operation[] @relation("FromMol")
  operationsTo   Operation[] @relation("ToMol")
  
  @@map("mols")
}

model AssetGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  assets      Asset[]
  
  @@map("asset_groups")
}

model Asset {
  id              String   @id @default(cuid())
  orderNumber     Int      @default(autoincrement())
  name            String
  inventoryNumber String   @unique
  unitPrice       Decimal  @db.Decimal(10, 2)
  unitOfMeasure   String
  quantity        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  
  molId           String
  mol             Mol      @relation(fields: [molId], references: [id])
  
  groupId         String
  group           AssetGroup @relation(fields: [groupId], references: [id])
  
  // Source of purchase
  contractCode    String?
  internalFundingCode String?
  isExistingAsset Boolean  @default(false)
  
  // Basis for recording
  recordingDate   DateTime
  documentType    String
  documentDetails String
  
  // Yandex.Disk file references
  documentFiles   String[] @default([])
  
  // Status
  status          AssetStatus @default(IN_STOCK)
  
  // Archive flag
  isArchived      Boolean  @default(false)
  
  // Planning
  plannedDisposalDate DateTime?
  plannedDisposalReason String?
  
  // Photos and notes
  photos          String[] @default([])
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  operations      Operation[]
  
  @@map("assets")
}

enum AssetStatus {
  IN_STOCK
  IN_USE
  UNDER_REPAIR
  PLANNED_FOR_DISPOSAL
  PARTIALLY_DISPOSED
  FULLY_DISPOSED
  
  @@map("asset_status")
}

enum OperationType {
  RECEIPT
  TRANSFER
  DISPOSAL
  STATUS_CHANGE
  
  @@map("operation_type")
}

model Operation {
  id          String   @id @default(cuid())
  type        OperationType
  
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  
  // For transfers
  fromMolId   String?
  fromMol     Mol?     @relation("FromMol", fields: [fromMolId], references: [id])
  
  toMolId     String?
  toMol       Mol?     @relation("ToMol", fields: [toMolId], references: [id])
  
  // Quantities
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(12, 2)
  
  // Document info
  date        DateTime
  reason      String?
  documentType String
  documentDetails String
  documentFiles String[] @default([])
  
  // Status change
  oldStatus   AssetStatus?
  newStatus   AssetStatus?
  
  createdAt   DateTime @default(now())
  
  @@map("operations")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())
  
  @@map("audit_logs")
}