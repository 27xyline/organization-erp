{
  "name": "project1-accounting",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean:next": "node -e \"['.next', '.next-dev', '.next-dev-turbo'].forEach((dir) => require('fs').rmSync(dir, { recursive: true, force: true }))\"",
    "prod:reset": "node -e \"['.next'].forEach((dir) => require('fs').rmSync(dir, { recursive: true, force: true }))\"",
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3001",
    "dev:turbo": "NEXT_DIST_DIR=.next-dev-turbo next dev -p 3001",
    "dev:webpack": "NEXT_DIST_DIR=.next-dev next dev --webpack -p 3001",
    "dev:reset": "npm run clean:next && npm run dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/notifications.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --outfile=dist/notifications-worker.cjs",
    "build:clean": "npm run clean:next && npm run build",
    "start": "next start -p 3001",
    "start:worker": "node dist/notifications-worker.cjs",
    "start:prod": "npm run build:clean && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/features/notifications/application/outbox.integration.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-data.ts",
    "user:create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@svar-ui/react-gantt": "^2.5.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "docx": "^9.7.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.24.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "nodemailer": "9.1.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "esbuild": "0.27.3",
    "globalthis": "^1.0.4",
    "jsdom": "^29.0.2",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.3"
  }
}
