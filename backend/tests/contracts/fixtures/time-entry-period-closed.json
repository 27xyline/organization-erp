{
  "name": "time-entry-period-closed",
  "kind": "synthetic-contract-example",
  "verification": "source-reviewed",
  "request": {
    "method": "PUT",
    "path": "/api/time-entries/synthetic-time-entry",
    "json": {
      "hours": 8
    }
  },
  "preconditions": [
    "Actor may update this existing entry",
    "Its payroll month is CLOSED",
    "No earlier validation/access error"
  ],
  "expected": {
    "status": 409,
    "json": {
      "error": {
        "code": "PERIOD_CLOSED",
        "message": "Расчётный месяц закрыт"
      }
    }
  },
  "sources": [
    "src/app/api/time-entries/[id]/route.ts",
    "src/features/timekeeping/application/http.ts",
    "src/features/timekeeping/application/__tests__/timekeeping-approval.integration.test.ts"
  ]
}
