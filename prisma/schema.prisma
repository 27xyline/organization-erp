generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mol {
  id              String     @id @default(cuid())
  code            String     @unique
  department      String
  departmentId    String
  departmentRef   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  fullName        String
  storageLocation String
  photo           String?
  employeeId      String?    @unique
  employee        Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assets         Asset[]
  holdings       AssetHolding[]
  operationsFrom Operation[]    @relation("FromMol")
  operationsTo   Operation[]    @relation("ToMol")

  @@index([departmentId])
  @@map("mols")
}

model Department {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String       @unique
  parentId       String?
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Department[] @relation("DepartmentHierarchy")
  headEmployeeId String?
  headEmployee   Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees      Employee[]            @relation("EmployeeDepartment")
  staffPositions StaffSchedule[]
  mols           Mol[]
  userScopes     UserDepartmentScope[]

  @@index([parentId])
  @@index([headEmployeeId])
  @@index([isActive, name])
  @@map("departments")
}

model AssetGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]

  @@map("asset_groups")
}

model Asset {
  id              String  @id @default(cuid())
  orderNumber     Int     @default(autoincrement())
  name            String
  inventoryNumber String  @unique
  unitPrice       Decimal @db.Decimal(10, 2)
  unitOfMeasure   String
  quantity        Decimal @db.Decimal(10, 2)
  totalCost       Decimal @db.Decimal(12, 2)

  molId String
  mol   Mol    @relation(fields: [molId], references: [id])

  groupId String
  group   AssetGroup @relation(fields: [groupId], references: [id])

  // Project relation
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Source of purchase
  contractCode        String?
  internalFundingCode String?
  isExistingAsset     Boolean @default(false)

  // Basis for recording
  recordingDate   DateTime
  documentType    String
  documentDetails String

  // Yandex.Disk file references
  documentFiles String[] @default([])

  // Status
  status AssetStatus @default(IN_STOCK)

  // Archive flag
  isArchived Boolean @default(false)

  // Planning
  plannedDisposalDate   DateTime?
  plannedDisposalReason String?

  // Photos and notes
  photos String[] @default([])
  notes  String?

  // Accounting form (145 or 367)
  accountingForm String @default("145")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations Operation[]
  holdings   AssetHolding[]
  documents  Document[]

  @@index([molId])
  @@index([groupId])
  @@index([status])
  @@index([isArchived, status])
  @@index([projectId])
  @@map("assets")
}

enum AssetStatus {
  IN_STOCK
  IN_USE
  UNDER_REPAIR
  PLANNED_FOR_DISPOSAL
  PARTIALLY_DISPOSED
  FULLY_DISPOSED

  @@map("asset_status")
}

enum OperationType {
  RECEIPT
  TRANSFER
  DISPOSAL
  STATUS_CHANGE

  @@map("operation_type")
}

model Operation {
  id   String        @id @default(cuid())
  type OperationType

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  // For transfers
  fromMolId String?
  fromMol   Mol?    @relation("FromMol", fields: [fromMolId], references: [id])

  toMolId String?
  toMol   Mol?    @relation("ToMol", fields: [toMolId], references: [id])

  // Quantities
  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(12, 2)

  // Document info
  date            DateTime
  reason          String?
  documentType    String
  documentDetails String
  documentFiles   String[] @default([])

  // Status change
  oldStatus AssetStatus?
  newStatus AssetStatus?

  createdAt DateTime @default(now())

  @@index([assetId, date])
  @@index([type, date])
  @@map("operations")
}

model AssetHolding {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  molId     String
  mol       Mol      @relation(fields: [molId], references: [id], onDelete: Restrict)
  quantity  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetId, molId])
  @@index([molId, assetId])
  @@map("asset_holdings")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER

  @@map("user_role")
}

enum AppRole {
  ADMIN
  HR
  ACCOUNTANT
  PROJECT_MANAGER
  ASSET_CUSTODIAN
  DEPARTMENT_HEAD
  AUDITOR
  EMPLOYEE

  @@map("app_role")
}

enum ScopeMode {
  NONE
  ALL
  ASSIGNED
  SELF

  @@map("scope_mode")
}

model User {
  id                      String                   @id @default(cuid())
  username                String                   @unique
  name                    String
  passwordHash            String
  role                    UserRole                 @default(VIEWER)
  isActive                Boolean                  @default(true)
  mustChangePassword      Boolean                  @default(true)
  sessionVersion          Int                      @default(1)
  passwordChangedAt       DateTime                 @default(now())
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  auditLogs               AuditLog[]
  employeeId              String?                  @unique
  employee                Employee?                @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  roleAssignments         UserRoleAssignment[]
  createdDocuments        Document[]               @relation("DocumentCreatedBy")
  uploadedVersions        DocumentVersion[]        @relation("DocumentVersionUploadedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationOutbox      NotificationOutbox[]
  requestedApprovals      ApprovalRequest[]        @relation("ApprovalRequestedBy")
  approvalSteps           ApprovalStep[]           @relation("ApprovalStepApprover")

  @@index([isActive, role])
  @@map("users")
}

model UserRoleAssignment {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                AppRole
  departmentScopeMode ScopeMode @default(NONE)
  projectScopeMode    ScopeMode @default(NONE)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  departmentScopes UserDepartmentScope[]
  projectScopes    UserProjectScope[]

  @@unique([userId, role])
  @@index([userId, role])
  @@map("user_role_assignments")
}

model UserDepartmentScope {
  id               String             @id @default(cuid())
  roleAssignmentId String
  roleAssignment   UserRoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())

  @@unique([roleAssignmentId, departmentId])
  @@index([departmentId, roleAssignmentId])
  @@map("user_department_scopes")
}

model UserProjectScope {
  id               String             @id @default(cuid())
  roleAssignmentId String
  roleAssignment   UserRoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())

  @@unique([roleAssignmentId, projectId])
  @@index([projectId, roleAssignmentId])
  @@map("user_project_scopes")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  details    Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

enum NotificationEventType {
  SYSTEM
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  CONTRACT_EXPIRING
  TASK_OVERDUE
  ASSET_DISPOSAL_DUE
  BUDGET_OVERRUN

  @@map("notification_event_type")
}

enum NotificationChannel {
  IN_APP
  EMAIL

  @@map("notification_channel")
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED

  @@map("notification_outbox_status")
}

model Notification {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  NotificationEventType
  channel    NotificationChannel
  title      String
  body       String
  targetUrl  String?
  entityType String?
  entityId   String?
  dedupeKey  String
  readAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime              @default(now())
  outbox     NotificationOutbox?

  @@unique([userId, dedupeKey, channel])
  @@index([userId, channel, deletedAt, readAt, createdAt])
  @@index([eventType, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType NotificationEventType
  channel   NotificationChannel
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([userId, eventType, channel])
  @@index([userId, channel])
  @@map("notification_preferences")
}

model NotificationOutbox {
  id             String                   @id @default(cuid())
  notificationId String                   @unique
  notification   Notification             @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         NotificationOutboxStatus @default(PENDING)
  payload        Json
  attempts       Int                      @default(0)
  availableAt    DateTime                 @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([userId, createdAt])
  @@map("notification_outbox")
}

enum ApprovalRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_request_status")
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED

  @@map("approval_step_status")
}

model ApprovalRequest {
  id          String                @id @default(cuid())
  title       String
  description String?
  entityType  String?
  entityId    String?
  status      ApprovalRequestStatus @default(DRAFT)
  currentStep Int                   @default(0)
  dueAt       DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  lockVersion Int                   @default(1)

  requestedById String
  requestedBy   User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  steps     ApprovalStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([requestedById, status, createdAt])
  @@index([status, dueAt])
  @@index([documentId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model ApprovalStep {
  id        String             @id @default(cuid())
  sequence  Int
  name      String
  status    ApprovalStepStatus @default(WAITING)
  comment   String?
  decidedAt DateTime?

  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation("ApprovalStepApprover", fields: [approverId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, sequence])
  @@index([approverId, status, createdAt])
  @@index([requestId, status])
  @@map("approval_steps")
}

// Projects
enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

model Project {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  goals       String?
  tasks       String?
  results     String?

  // Dates
  startDate DateTime?
  endDate   DateTime?

  // Status
  status ProjectStatus @default(ACTIVE)

  // Budget
  plannedBudget Decimal @default(0) @db.Decimal(12, 2)
  actualBudget  Decimal @default(0) @db.Decimal(12, 2)

  // Relations
  assets             Asset[]
  tasksList          Task[]
  financePlanEntries FinancePlanEntry[]
  projectMembers     ProjectMember[]
  userScopes         UserProjectScope[]
  documents          Document[]
  approvalRequests   ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model ProjectMember {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskAssignees TaskAssignee[]
  department    String
  position      String
  rate          Decimal        @db.Decimal(5, 2)
  salary        Decimal        @db.Decimal(12, 2)
  isArchived    Boolean        @default(false)
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, employeeId])
  @@index([projectId, isArchived])
  @@index([employeeId, isArchived])
  @@map("project_members")
}

// Tasks with 3-level hierarchy
model Task {
  id   String @id @default(cuid())
  name String

  // Hierarchy (Level 1, 2, 3)
  level    Int     @default(1) // 1, 2, or 3
  parentId String?
  parent   Task?   @relation("TaskChildren", fields: [parentId], references: [id])
  children Task[]  @relation("TaskChildren")

  // Dates and duration
  startDate DateTime?
  endDate   DateTime?
  duration  Int? // in days

  // Progress
  progress Int @default(0) // 0-100%

  // Legacy responsible person field kept for backwards-compatible display.
  responsible String?
  assignees   TaskAssignee[]

  // Status
  status TaskStatus @default(NOT_STARTED)

  // Project relation
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, parentId])
  @@map("tasks")
}

model TaskAssignee {
  id              String         @id @default(cuid())
  taskId          String
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectMemberId String?
  projectMember   ProjectMember? @relation(fields: [projectMemberId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@unique([taskId, employeeId])
  @@index([employeeId])
  @@index([projectMemberId])
  @@map("task_assignees")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED

  @@map("task_status")
}

// Employees and HR
model Employee {
  id                 String                 @id @default(cuid())
  code               String                 @unique // Табельный номер
  fullName           String
  department         String
  departmentId       String
  departmentRef      Department             @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  photo              String?
  contractType       EmploymentContractType @default(PRIMARY)
  contractSignedDate DateTime?
  contractEndDate    DateTime?
  contractNumber     String?

  // Contact info
  phone         String?
  email         String?
  birthDate     DateTime?
  education     String?
  qualification String?

  managerId     String?
  manager       Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeManager")

  // Staff schedule position
  staffScheduleId String?
  staffSchedule   StaffSchedule? @relation(fields: [staffScheduleId], references: [id])
  employmentRate  Decimal        @default(1) @db.Decimal(5, 2) // Количество ставок сотрудника

  // Status
  status EmployeeStatus @default(ACTIVE)

  // Relations
  vacations          Vacation[]
  actions            PersonnelAction[]
  salaryEntries      SalaryEntry[]
  financePlanEntries FinancePlanEntry[]
  projectMembers     ProjectMember[]
  taskAssignees      TaskAssignee[]
  headedDepartments  Department[]          @relation("DepartmentHead")
  user               User?                 @relation("UserEmployee")
  documents          Document[]
  skills             EmployeeSkill[]
  certificates       EmployeeCertificate[]
  mol                Mol?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, fullName])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  level      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, name])
  @@index([employeeId])
  @@map("employee_skills")
}

model EmployeeCertificate {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  number     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, expiresAt])
  @@map("employee_certificates")
}

enum EmployeeStatus {
  ACTIVE
  ON_VACATION
  ON_SICK_LEAVE
  DISMISSED

  @@map("employee_status")
}

enum EmploymentContractType {
  PRIMARY
  INTERNAL
  EXTERNAL

  @@map("employment_contract_type")
}

model StaffSchedule {
  id            String     @id @default(cuid())
  position      String // Название должности
  department    String // Отдел
  departmentId  String
  departmentRef Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rate          Decimal    @db.Decimal(5, 2) // Количество ставок
  salary        Decimal    @db.Decimal(10, 2) // Зарплата

  // Relations
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@map("staff_schedule")
}

model SalaryEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  month      Int
  amount     Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@map("salary_entries")
}

enum FinancePlanType {
  OKLAD
  NADBAVKA

  @@map("finance_plan_type")
}

model FinancePlanEntry {
  id         String          @id @default(cuid())
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  projectId  String?
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  type       FinancePlanType
  amount     Decimal         @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month, type, projectId])
  @@index([employeeId, year, month, type])
  @@index([year, month, type])
  @@map("finance_plan_entries")
}

model PersonnelAction {
  id          String              @id @default(cuid())
  type        PersonnelActionType
  date        DateTime
  description String?

  // Employee
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Additional data
  oldDepartment      String?
  newDepartment      String?
  oldPosition        String?
  newPosition        String?
  oldContractEndDate DateTime?
  newContractEndDate DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId, date])
  @@map("personnel_actions")
}

enum PersonnelActionType {
  HIRE
  DISMISS
  ARCHIVE
  TRANSFER
  EXTEND
  PROMOTE
  EDIT

  @@map("personnel_action_type")
}

model Vacation {
  id        String       @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  type      VacationType @default(VACATION)

  // Employee
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId, startDate])
  @@map("vacations")
}

enum VacationType {
  VACATION
  SICK_LEAVE
  BUSINESS_TRIP
  UNPAID_LEAVE

  @@map("vacation_type")
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SIGNED
  ARCHIVED

  @@map("document_status")
}

enum DocumentCategory {
  GENERAL
  CONTRACT
  ORDER
  ACT
  INVOICE
  PERSONNEL
  PROJECT
  ASSET
  OTHER

  @@map("document_category")
}

model Document {
  id             String           @id @default(cuid())
  title          String
  description    String?
  category       DocumentCategory @default(GENERAL)
  status         DocumentStatus   @default(DRAFT)
  currentVersion Int              @default(1)
  lockVersion    Int              @default(1)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         DocumentVersion[]
  approvalRequests ApprovalRequest[]

  @@index([status, updatedAt])
  @@index([category, updatedAt])
  @@index([projectId])
  @@index([employeeId])
  @@index([assetId])
  @@index([createdById])
  @@index([archivedAt, updatedAt])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  extension        String
  sizeBytes        BigInt
  sha256           String
  comment          String?

  uploadedById String
  uploadedBy   User   @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([uploadedById])
  @@map("document_versions")
}
